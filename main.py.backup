from SerialHandler import SerialHandler
from XbusPacket import XbusPacket
from DataPacketParser import DataPacketParser, XsDataPacket
from SetOutput import set_output_conf
import time
from data_logging import save_data_to_csv
from datetime import datetime
import numpy as np
from collections import deque

# Класс для расчёта вибрации
class VibrationAnalyzer:
    def __init__(self, window_size=50):
        self.window_size = window_size
        self.acc_x = deque(maxlen=window_size)
        self.acc_y = deque(maxlen=window_size)
        self.acc_z = deque(maxlen=window_size)
    
    def add_data(self, x, y, z):
        self.acc_x.append(x)
        self.acc_y.append(y)
        self.acc_z.append(z)
    
    def get_rms(self):
        if len(self.acc_x) < self.window_size:
            return None
        rms_x = np.sqrt(np.mean(np.square(self.acc_x)))
        rms_y = np.sqrt(np.mean(np.square(self.acc_y)))
        rms_z = np.sqrt(np.mean(np.square(self.acc_z)))
        total = np.sqrt(rms_x**2 + rms_y**2 + rms_z**2)
        return rms_x, rms_y, rms_z, total


def on_live_data_available(packet, filename, vib_analyzer=None):
    xbus_data = XsDataPacket() 
    DataPacketParser.parse_data_packet(packet, xbus_data)

    # Расчёт вибрации
    if vib_analyzer and xbus_data.accAvailable:
        vib_analyzer.add_data(xbus_data.acc[0], xbus_data.acc[1], xbus_data.acc[2])
        rms = vib_analyzer.get_rms()
        if rms:
            print(f"\n📊 VIBRATION: RMS_X={rms[0]:.4f} RMS_Y={rms[1]:.4f} RMS_Z={rms[2]:.4f} | TOTAL={rms[3]:.4f} m/s²")

    # Основные данные
    if xbus_data.packetCounterAvailable:
        print(f"\npacketCounter: {xbus_data.packetCounter}, ", end='')

    if xbus_data.sampleTimeFineAvailable:
        print(f"sampleTimeFine: {xbus_data.sampleTimeFine}, ", end='')

    if xbus_data.eulerAvailable:
        print(f"\nRoll, Pitch, Yaw: [{xbus_data.euler[0]:.2f}, {xbus_data.euler[1]:.2f}, {xbus_data.euler[2]:.2f}], ", end='')

    if xbus_data.rotAvailable:
        rate_of_turn_degree = [
            xbus_data.rad2deg * xbus_data.rot[0],
            xbus_data.rad2deg * xbus_data.rot[1],
            xbus_data.rad2deg * xbus_data.rot[2]
        ]
        print(f"\nRateOfTurn (deg/s): [{rate_of_turn_degree[0]:.2f}, {rate_of_turn_degree[1]:.2f}, {rate_of_turn_degree[2]:.2f}], ", end='')

    if xbus_data.accAvailable:
        print(f"Acceleration (m/s^2): [{xbus_data.acc[0]:.2f}, {xbus_data.acc[1]:.2f}, {xbus_data.acc[2]:.2f}], ", end='')

    if xbus_data.magAvailable:
        print(f"Magnetic Field (uT): [{xbus_data.mag[0]:.2f}, {xbus_data.mag[1]:.2f}, {xbus_data.mag[2]:.2f}]")

    save_data_to_csv(xbus_data, filename, log_position_velocity=False)


def main():
    try:
        serial = SerialHandler("/dev/ttyUSB0", 115200)

        go_to_config = bytes.fromhex('FA FF 30 00')
        go_to_measurement = bytes.fromhex('FA FF 10 00')

        serial.send_with_checksum(go_to_config)
        print("Переход в конфигурационный режим...")
        time.sleep(0.1)

        set_output_conf(serial)
        print("Настройка выходных данных...")
        time.sleep(0.1)

        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        filename = f'{timestamp}.csv'
        
        serial.send_with_checksum(go_to_measurement)
        print("Переход в измерительный режим...")
        print("Listening for packets... (Ctrl+C для остановки)\n")

        # Создаём анализатор вибрации
        vib_analyzer = VibrationAnalyzer(window_size=50)

        packet = XbusPacket(on_data_available=lambda p: on_live_data_available(p, filename, vib_analyzer))

        while True:
            try:
                byte = serial.read_byte()
                if byte:
                    packet.feed_byte(byte)
            except RuntimeError as e:
                print(f"Error reading byte: {e}")
                continue

    except KeyboardInterrupt:
        print("\n\nОстановлено пользователем")
        return 0
    except Exception as e:
        print(f"Error: {e}")
        return 1

if __name__ == '__main__':
    main()
