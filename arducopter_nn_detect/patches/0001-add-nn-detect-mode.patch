 ArduCopter/config.h           |   6 +
 ArduCopter/mode.cpp           |   5 +
 ArduCopter/mode.h             |  51 +++++++
 ArduCopter/mode_nn_detect.cpp | 269 ++++++++++++++++++++++++++++++++++
 5 files changed, 335 insertions(+)
 create mode 100644 ArduCopter/mode_nn_detect.cpp

